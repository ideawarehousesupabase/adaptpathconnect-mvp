# Firebase web app config (Firebase console → Project settings → Your apps).
# Optional: if VITE_FIREBASE_API_KEY is unset, the key is read from the GOOGLE_API_KEY server secret.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Optional: local development against the Firebase emulators (`firebase emulators:start`)
VITE_FIREBASE_AUTH_EMULATOR_HOST=
VITE_FIRESTORE_EMULATOR_HOST=
VITE_FIREBASE_STORAGE_EMULATOR_HOST=
